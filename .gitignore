# Real business/ICP data — never commit (see docs/SENSITIVE_DATA.md)
config/icps/*/lookups/*.csv
!config/icps/*/lookups/*.example.csv
*.xlsx
config/local.yaml

# Automation run artifacts (logs, state, screenshots, sessions, queue)
automation/**/shots/
automation/**/rollout_shots/
automation/**/rollout_logs/
automation/**/rollout_state*.json
automation/**/queue/
automation/**/*.log
automation/**/*.err
automation/clay_sync/*session*.json
automation/clay_sync/*.state.json

# Cleanup / rollout passes — every generated .json (manifests, inventories,
# per-run state, targets, batch/shard lists) carries live workspace + workbook
# ids, and every *_logs/ dir is a run artifact. Regenerate manifests with the
# build_*.py scripts. Committed code (*.py + people_fill_lib.js) is portable.
automation/cleanup/*.json
automation/cleanup/*_logs/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Pasted, group-specific inputs kept at the repo root. Query files like
# "People - Filters*.txt" are written for one batch of workbooks (not part of the
# uniform process) and hold live Clay table/view/filter ids, which
# SENSITIVE_DATA.md keeps out of the repo; the screenshots are run artifacts.
# Pass such a file to people_search_event.py with --queries.
/People - Filters*.txt
/Query Skill.md
/*.png
# Pre-merge snapshots written by the people-builds rollout
*.premerge
# Import-run state/logs from the EVCharge pass (live workbook ids)
automation/clay_sync/*_state.json
automation/clay_sync/*_state_*.json
automation/clay_sync/evcharge_logs/

# Live Clay query files — carry table/view/filter IDs (workspace identifiers)
# AND the full targeted title/country lists, i.e. the same proprietary ICP
# targeting logic that *_contact_titles.csv is excluded for. See
# docs/SENSITIVE_DATA.md. The shape and the correctness rules are documented in
# docs/PEOPLE_STEP.md; the values stay local.
People - Filters*.txt

# Blocklist ledger — real company/people exports fed to load_csv.js
blocklist_ledger/*.csv
