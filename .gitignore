# Real business/ICP data — never commit (see docs/SENSITIVE_DATA.md)
config/icps/*/lookups/*.csv
!config/icps/*/lookups/*.example.csv
*.xlsx
config/local.yaml

# Automation run artifacts (logs, state, screenshots, sessions, queue)
automation/**/shots/
automation/**/rollout_shots/
automation/**/rollout_logs/
automation/**/rollout_state*.json
automation/**/queue/
automation/**/*.log
automation/**/*.err
automation/clay_sync/*session*.json
automation/clay_sync/*.state.json

# Cleanup / rollout passes — every generated .json (manifests, inventories,
# per-run state, targets, batch/shard lists) carries live workspace + workbook
# ids, and every *_logs/ dir is a run artifact. Regenerate manifests with the
# build_*.py scripts. Committed code (*.py + people_fill_lib.js) is portable.
automation/cleanup/*.json
automation/cleanup/*_logs/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db
