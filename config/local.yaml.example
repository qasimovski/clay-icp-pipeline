# Local, account-specific config — copy to config/local.yaml (gitignored)
# and fill in your own values. These identify YOUR live Clay
# workspace/account, not the reusable process, so they don't belong in git.

workspace_url: "https://app.clay.com/workspaces/REPLACE_ME/home/REPLACE_ME"
workspace_name: "REPLACE_ME"          # e.g. "Labs [2026 - Qasim - Fable]"
events_folder: "Competitive Events"    # folder holding one workbook per event
blocklist_table: "REPLACE_ME - Blocklist - Companies"   # one level up from events_folder

# EVCharge import (automation/clay_sync/import_evcharge.py). Find these by
# opening the folder in Clay and reading the ids out of the URL. Environment
# overrides: CLAY_WORKSPACE_ID / CLAY_EVCHARGE_FOLDER_ID /
# CLAY_EVCHARGE_SUBFOLDER_ID.
workspace_id: "REPLACE_ME"
evcharge_folder_id: "REPLACE_ME"       # the EVCharge folder
evcharge_subfolder_id: "REPLACE_ME"    # "Competitive Events" inside it

# Blocklist destination (automation/build_automation/blocklist_send.py). Open
# the blocklist workbook's Table 1 in Clay and read the three ids out of the
# URL: /workspaces/<workspace_id>/workbooks/<wb>/tables/<t>/views/<gv>.
# Environment overrides: CLAY_BLOCKLIST_WORKBOOK_ID / CLAY_BLOCKLIST_TABLE_ID
# / CLAY_BLOCKLIST_VIEW_ID. The workbook's display name (used to build the
# send-destination path) overrides via CLAY_BLOCKLIST_WORKBOOK.
blocklist_workbook_id: "REPLACE_ME"    # wb_...
blocklist_table_id: "REPLACE_ME"       # t_...
blocklist_view_id: "REPLACE_ME"        # gv_...
