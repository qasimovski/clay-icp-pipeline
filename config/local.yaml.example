# Local, account-specific config — copy to config/local.yaml (gitignored)
# and fill in your own values. These identify YOUR live Clay
# workspace/account, not the reusable process, so they don't belong in git.

workspace_url: "https://app.clay.com/workspaces/REPLACE_ME/home/REPLACE_ME"
workspace_name: "REPLACE_ME"          # e.g. "Labs [2026 - Qasim - Fable]"
events_folder: "Competitive Events"    # folder holding one workbook per event

# Blocklist = the Supabase ledger (blocklist_ledger/), reached from Clay by an
# HTTP API column that returns `Is New`. These name the Clay-side saved
# template and the connected account it runs under. Both optional; the
# defaults below are what the Labs workspace uses.
blocklist_ledger_template: "Companies - Supabase"
blocklist_api_account: "REPLACE_ME"    # e.g. "Qasim - Labs"

# Legacy: the shared Clay "Block List" table the pipeline used to Send Table
# Data into, before the Supabase ledger replaced it. Only needed if you still
# run automation/build_automation (the Interphex-era reference build).
blocklist_table: "REPLACE_ME - Blocklist - Companies"   # one level up from events_folder

# EVCharge import (automation/clay_sync/import_evcharge.py). Find these by
# opening the folder in Clay and reading the ids out of the URL. Environment
# overrides: CLAY_WORKSPACE_ID / CLAY_EVCHARGE_FOLDER_ID /
# CLAY_EVCHARGE_SUBFOLDER_ID.
workspace_id: "REPLACE_ME"
evcharge_folder_id: "REPLACE_ME"       # the EVCharge folder
evcharge_subfolder_id: "REPLACE_ME"    # "Competitive Events" inside it
evcharge_ps_folder_id: "REPLACE_ME"    # "Products & Services" inside it
evcharge_buyside_folder_id: "REPLACE_ME"  # "Buyside P&S" inside it
                                       # (automation/cleanup/build_ps_companies.py;
                                       #  override with CLAY_EVCHARGE_PS_FOLDER_ID)

# Highways import (automation/clay_sync/import_highways.py). Same shape as the
# EVCharge ids above — read them out of the folder URL in Clay. Environment
# overrides: CLAY_HIGHWAYS_FOLDER_ID / CLAY_HIGHWAYS_SUBFOLDER_ID.
highways_folder_id: "REPLACE_ME"       # the Highways folder
highways_subfolder_id: "REPLACE_ME"    # "Competitive Events" inside it
# The handoff folder for review copies, e.g.
#   "Highways - Qasim to Katie" -> "Competitive Events"
# Created by hand in Clay; nothing in this repo creates folders. Open the
# SUBFOLDER and take the id from the URL. import_ce_delivery_tables.py can
# reach nothing outside it.
highways_delivery_folder_id: ""   # or $CLAY_HIGHWAYS_DELIVERY_FOLDER_ID

highways_ps_folder_id: "REPLACE_ME"    # "Products & Services" inside it
highways_buyside_ps_folder_id: "REPLACE_ME"  # "BuySide P&S" inside it
                                       # (read as <icp>_ps_folder_id, so the ICP
                                       #  dir is config/icps/highways_buyside/)
                                       # (automation/cleanup/build_ps_companies.py
                                       #  --icp highways; override with
                                       #  CLAY_HIGHWAYS_PS_FOLDER_ID)

# Supabase project holding the blocklist ledgers (blocklist_ledger/). Used to
# build the Clay HTTP-API column URLs:
#   https://<supabase_project_ref>.supabase.co/rest/v1/rpc/<ledger_check_fn>
# The publishable key is NOT stored here — it lives in the Clay saved account.
supabase_project_ref: "REPLACE_ME"

# Blocklist destination (automation/build_automation/blocklist_send.py). Open
# the blocklist workbook's Table 1 in Clay and read the three ids out of the
# URL: /workspaces/<workspace_id>/workbooks/<wb>/tables/<t>/views/<gv>.
# Environment overrides: CLAY_BLOCKLIST_WORKBOOK_ID / CLAY_BLOCKLIST_TABLE_ID
# / CLAY_BLOCKLIST_VIEW_ID. The workbook's display name (used to build the
# send-destination path) overrides via CLAY_BLOCKLIST_WORKBOOK.
blocklist_workbook_id: "REPLACE_ME"    # wb_...
blocklist_table_id: "REPLACE_ME"       # t_...
blocklist_view_id: "REPLACE_ME"        # gv_...

# Where export_event_tables.py / unhide_timestamps_and_export.py write the
# downloaded CSVs: <export_root>/<Workbook>/<Table name>.csv. A local
# filesystem path, so it varies per machine. Override: $CLAY_EXPORT_ROOT.
export_root: "REPLACE_ME"              # e.g. C:\Users\you\Labs - Tables

# Highways Workflows route (docs/WORKFLOWS_ROUTE.md). Read back from a live
# workflow with `clay workflows graph get <wfId>`; the people workflow's own
# ids live in the gitignored automation/cleanup/ce_nodes/people_workflow.json,
# written when it is built.
highways_ce_workflow_id: ""   # the CE classification workflow (Registrar)
highways_ce_registrar_node_id: ""   # its Highways Registrar agent node
highways_ce_build_node_id: ""   # its Build Company Record node
highways_ce_mapping_node_id: ""   # its ICP Mapping node
highways_other_sources_table_id: ""   # ALL_SOURCES_DEDUPED
